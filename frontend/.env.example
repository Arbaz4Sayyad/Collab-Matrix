# Environment variables for CollabMatrix Frontend
# When running locally with Docker / Nginx reverse proxy, leave empty or use default relative paths:
# VITE_API_URL=/api
# VITE_WS_URL=/ws

# When deploying frontend on Vercel/Netlify with backend hosted separately (e.g. Render/Koyeb):
# VITE_API_URL=https://your-backend-service.onrender.com/api
# VITE_WS_URL=https://your-backend-service.onrender.com/api/ws
